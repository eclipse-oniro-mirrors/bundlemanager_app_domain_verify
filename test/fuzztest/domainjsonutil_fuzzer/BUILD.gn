#####################hydra-fuzz###################
import("../../../app_domain_verify.gni")
import("//build/config/features.gni")
import("//build/test.gni")

##############################fuzztest##########################################
ohos_fuzztest("DomainjsonutilFuzzTest") {
  module_out_path = "app_domain_verify/app_domain_verify"

  include_dirs = [
    "${app_domain_verify_frameworks_verifier_path}/include",
    "${app_domain_verify_frameworks_common_path}/include/utils",
    "${app_domain_verify_frameworks_common_path}/include",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "domainjsonutil_fuzzer.cpp" ]

  deps = [
    "${app_domain_verify_frameworks_verifier_path}:app_domain_verify_agent_verifier",
  ]

  external_deps = [
    "c_utils:utils",
    "cJSON:cjson",
  ]
}
###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":DomainjsonutilFuzzTest",
  ]
}
